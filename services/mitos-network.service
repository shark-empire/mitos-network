[Unit]
Description=mitosOS network management daemon
Documentation=file:///usr/share/doc/mitos-network/architecture.md
# mitos-network manages interfaces/addresses/routes over rtnetlink and
# needs the Linux networking stack itself up first; it does not need
# to wait for any particular interface to be *configured* (that's its
# own job).
After=network-pre.target local-fs.target
Before=network.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/mitos-network
ExecReload=/usr/bin/mitos-netctl reload
Restart=on-failure
RestartSec=2

# Runs as root: rtnetlink link/address/route changes, raw DHCP sockets
# on port 68, nftables, and sethostname(2) all require it. Capability
# bounding (rather than a non-root user) is the realistic hardening
# path here -- see docs/security.md for what's actually enforced today
# versus left as a follow-up.
User=root
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN

RuntimeDirectory=mitos-network
RuntimeDirectoryMode=0755
StateDirectory=mitos-network
StateDirectoryMode=0700
ConfigurationDirectory=mitos-network

ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/resolv.conf /etc/hostname /run/mitos-network /var/lib/mitos-network
PrivateTmp=true

# `NoNewPrivileges=true` blocks a process (and anything it execs) from
# gaining privilege beyond what it started with -- e.g. via a setuid
# binary or a file capability. Safe to enable here specifically because
# this unit already runs as `User=root`: root gets everything in
# `CapabilityBoundingSet` from exec() onward with no setuid/fscap step
# involved, for this daemon or for `nft`/`wg`/`openvpn`/`hostapd`/
# `bluetoothctl` underneath it, so there's nothing this flag would
# break. (Deliberately not setting `ProtectHostname=true`: this daemon
# calls `sethostname(2)` -- see `dns/hostname.rs` -- which that
# directive exists specifically to block.)
NoNewPrivileges=true

# Everything below is additional sandboxing with no functional
# dependency found anywhere in this daemon -- no kernel module
# loading, no cgroup/clock/realtime manipulation, no namespace
# creation, no JIT'd or self-modifying code, no exotic socket families
# beyond Unix/IPv4/IPv6/netlink/packet.
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
