[Unit]
Description=mitosOS network management daemon
Documentation=file:///usr/share/doc/mitos-network/architecture.md
# mitos-network manages interfaces/addresses/routes over rtnetlink and
# needs the Linux networking stack itself up first; it does not need
# to wait for any particular interface to be *configured* (that's its
# own job).
After=network-pre.target local-fs.target
Before=network.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/mitos-network
ExecReload=/usr/bin/mitos-netctl reload
Restart=on-failure
RestartSec=2

# Runs as root: rtnetlink link/address/route changes, raw DHCP sockets
# on port 68, nftables, and sethostname(2) all require it. Capability
# bounding (rather than a non-root user) is the realistic hardening
# path here -- see docs/security.md for what's actually enforced today
# versus left as a follow-up.
User=root
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN

RuntimeDirectory=mitos-network
RuntimeDirectoryMode=0755
StateDirectory=mitos-network
StateDirectoryMode=0700
ConfigurationDirectory=mitos-network

ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/resolv.conf /etc/hostname /run/mitos-network /var/lib/mitos-network
PrivateTmp=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
